# Copy to server/.env and fill in. Every value is optional — the server starts
# without any of them and hosts guest games exactly as it always has. Each
# section switches on the features next to it.

# Port Express + Socket.io listen on.
PORT=3001

# Where the browser may call the API from. "*" is fine for a LAN game night;
# set your real origin in production.
CORS_ORIGIN=*

# ── Accounts, friends, chat and game history ────────────────────────────────
# Both of these are needed. Without them /api/auth/* answers 503 and the client
# hides the sign-in UI.
MONGODB_URI=mongodb+srv://nykahlouche_db_user:FR3YMWH4GQ3Xdcls@cluster0.rffbtjk.mongodb.net/
MONGODB_DB=scrabble-live
# Any long random string. Changing it signs everyone out.
JWT_SECRET=
JWT_EXPIRES_IN=30d

# ── Profile pictures ────────────────────────────────────────────────────────
# Without these the profile page keeps working; only the upload button is off.
CLOUDINARY_CLOUD_NAME=dygwvtddd
CLOUDINARY_API_KEY=137793928714971
CLOUDINARY_API_SECRET=g0kROEvWOn5bI4OSes2IQUbZ5gY
CLOUDINARY_FOLDER=scrabble-live/avatars
